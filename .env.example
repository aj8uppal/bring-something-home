# Node server; npm run dev uses SERVER_PORT for the backend.
HOST=127.0.0.1
PORT=8790
SERVER_PORT=8790
DATA_PATH=data/emberwilds.sqlite
# Same-origin browser connections work by default. Comma-separated additional
# origins are only needed when serving the client from a different origin.
ALLOWED_ORIGINS=
# Enable only behind a trusted proxy that overwrites X-Forwarded-For and blocks
# direct access to the backend. Otherwise leave unset.
TRUST_PROXY=0
# On Fly.io with direct Fly Proxy ingress, use TRUST_PROXY=fly to read Fly-Client-IP.
